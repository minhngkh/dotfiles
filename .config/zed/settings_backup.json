// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "collaboration_panel": {
    "dock": "right"
  },
  "lsp": {
    "markdownlint": {
      "settings": {
        "MD013": false,
        "MD041": false
      },
    },
  },
  "show_signature_help_after_edits": false,
  "always_treat_brackets_as_autoclosed": false,
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "github-copilot": {
      "default_model": "gpt-5-mini",
      "favorite_models": ["gpt-5-mini", "claude-sonnet-4.6", "auto"],
      "type": "registry",
    },
    "opencode": {
      "default_model": "openai/gpt-5.3-codex",
      "favorite_models": [
        "github-copilot/gpt-5-mini/high",
        "github-copilot/claude-sonnet-4.6/thinking",
        "openai/gpt-5.3-codex-spark",
        "openai/gpt-5.3-codex",
      ],
      "type": "registry",
    },
  },
  "icon_theme": "Base Charmed Icons",
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "provider": "copilot",
  },
  "file_scan_exclusions": ["**/bin/**", "**/obj/**"],
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": true,
    },
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
      "enable_thinking": false,
    },
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
    "collapse_untracked_diff": false,
  },
  "outline_panel": {
    "dock": "right",
    "indent_guides": {
      "show": "always",
    },
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": true,
    "indent_guides": {
      "show": "always",
    },
    "bold_folder_labels": false,
    "starts_open": true,
    "folder_icons": true,
    "entry_spacing": "standard",
    "dock": "right",
  },
  "use_system_window_tabs": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": false,
  },
  "title_bar": {
    "show_user_picture": true,
    "show_menus": false,
    "show_branch_name": true,
    "show_branch_icon": true,
  },
  "proxy": "http://127.0.0.1:3128",
  "languages": {
    "CSharp": {
      "use_on_type_format": false,
      "tab_size": 4,
      "preferred_line_length": 100,
      "formatter": {
        "external": {
          "command": "fast-csharpier",
          "arguments": ["{buffer_path}"],
        },
      },
    },
  },
  "semantic_tokens": "combined",
  "colorize_brackets": true,
  "format_on_save": "off",
  "tab_size": 2,
  "toolbar": {
    "code_actions": true,
  },
  "redact_private_values": true,
  "session": {
    "trust_all_worktrees": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Zedokai (Filter Spectrum)",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "experimental.theme_overrides": {
    "editor.background": "#1e1e1e",
    "editor.gutter.background": "#1e1e1e",
    "tab_bar.background": "#1e1e1e",
    "terminal.background": "#1e1e1e",
    "toolbar.background": "#1e1e1e",
    "status_bar.background": "#1e1e1e",
    "title_bar.background": "#1e1e1e",
    "panel.background": "#1e1e1e",
    "border": "#f1f1f1f1",
  },
}

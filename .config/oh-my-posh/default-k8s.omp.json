{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": " {{ .Folder }} :: {{if .Root}}Admin{{end}}",
  "palette": {
    "main-bg": "#24283b",
    "terminal-red": "#f7768e",
    "pistachio-green": "#9ece6a",
    "terminal-green": "#73daca",
    "terminal-yellow": "#e0af68",
    "terminal-blue": "#7aa2f7",
    "celeste-blue": "#b4f9f8",
    "light-sky-blue": "#7dcfff",
    "terminal-white": "#c0caf5",
    "white-blue": "#a9b1d6",
    "blue-bell": "#9aa5ce",
    "pastal-grey": "#cfc9c2",
    "terminal-magenta": "#bb9af7",
    "blue-black": "#565f89",
    "terminal-black": "#414868",
    "t-background": "p:main-bg"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "white",
          "style": "plain",
          "template": "<lightWhite></> <white>{{.Context}}</>{{if .Namespace}}::<white>{{.Namespace}}</>{{end}} <lightWhite>|</> ",
          "type": "kubectl"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "lightYellow",
          "template": "{{ .UserName }}</><darkGray>@{{ .HostName }}</> "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "blue",
          "options": {
            "style": "folder"
          },
          "template": "<lightWhite>in</> <b>{{ .Path }}</b> "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "white",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}magenta{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0)}}green {{ end }}",
            "{{ if gt .Ahead 0 }}lightBlue{{ end }}",
            "{{ if gt .Behind 0 }}lightRed{{ end }}"
          ],
          "template": "<lightWhite>on</> {{ .HEAD}}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}",
          "options": {
            "fetch_status": true,
            "branch_icon": "\ue725 ",
            "mapped_branches": {
              "feature/*": " /",
              "fix/*": " /",
              "hotfix/*": " /"
            }
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "red",
          "template": " \uf00d"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "react",
          "style": "plain",
          "foreground": "lightBlue",
          "template": " {{ .Major }} "
        },
        {
          "type": "angular",
          "style": "plain",
          "foreground": "magenta",
          "template": " {{ .Major }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "green",
          "template": " {{ .Major }} "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "#512BD4",
          "template": "󰪮 {{ .Major }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "yellow",
          "template": "\uE235 {{ .Major }}"
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "lightBlue",
          "template": "\uFCD1 {{ .Major}}"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "lightGreen",
          "style": "plain",
          "template": "\u26a1",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "blue",
    "template": "\u279c "
  },
  "final_space": true,
  "version": 4
}

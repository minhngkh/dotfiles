#!/usr/bin/bash
# Launch ghostty via nixGL, bypassing the Nix C wrapper to avoid dconf
# (ABI mismatch: libdconfsettings.so vs host glib on non-NixOS)

ghostty_real=$(dirname "$(readlink -f ~/.nix-profile/bin/ghostty)")/.ghostty-wrapped

exec /usr/bin/env -u GIO_EXTRA_MODULES -u GIO_MODULE_DIR \
  nixGL "$ghostty_real" "$@"

{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    ["@plannotator/opencode@0.24.2", { "workflow": "manual" }],
    "@slkiser/opencode-quota@4.2.0",
    "@mohak34/opencode-notifier@0.2.8",
    "oh-my-opencode-slim@2.2.8",
  ],
  "lsp": {},
  "formatter": {
    "csharpier": {
      "disabled": true,
      "command": ["csharpier", "format", "$FILE"],
      "extensions": [".cs"],
    },
  },
  "mcp": {
    "executor": {
      "type": "remote",
      "url": "http://localhost:4789/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer 5cKbBUGfkYIzd8hzlmuuJMbCAZBfKT4N8A5bXZIuuiA",
      },
    },
  },
  "permission": {
    "quota_status": "deny",
    "external_directory": {
      "/home/gmi4hc/.config/opencode/*": "allow",
      "/home/gmi4hc/.agents/*": "allow",
      "/tmp/*": "allow",
      "/home/gmi4hc/.ref/*": "allow",
      "/home/gmi4hc/.btca/*": "allow",
    },
    "skill": {
      "ask-matt": "deny",
      "clonedeps": "deny",
      "codemap": "deny",
      "customize-opencode": "deny",
      "deepwork": "deny",
      "oh-my-opencode-slim": "deny",
      "plannotator-*": "deny",
      "reflect": "deny",
      "release-smoke-test": "deny",
      "setup-matt-pocock-skills": "deny",
      "teach": "deny",
      "wayfinder": "deny",
      "writing-great-skills": "deny",
    },
  },
  "agent": {
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "build": {
      "disable": false,
    },
    "plan": {
      "disable": true,
    },
  },
  "provider": {
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // Detected opencode-go authentication; opencode-quota added this global provider declaration.
    "opencode-go": {},
     "devmate": {
      "name": "Devmate Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://devmate.bosch.com/api/v3",
        "apiKey": "{env:DEVMATE_API_KEY}",
        "includeUsage": false,
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 1050000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 1050000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 1050000
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 1000000
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 1000000
          }
        },
        "claude-haiku-4-5@20251001": {
          "name": "Claude Haiku 4.5",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 65535
          }
        },
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 65535
          }
        }
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "https://devmate.bosch.com/api/anthropic"
      }
    },
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {}

  },
}

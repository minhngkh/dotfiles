{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[37m", "\u001b[38;5;214m", "\u001b[38;5;215m", "\u001b[38;5;216m"]
    },
    "modules": [
        // "break",
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1} │"
        },
        {
            "type": "command",
            "key": "│   cpu",
            "text": "lscpu | sed -rn 's/Model name:.* ([^ ]+ @ [^ ]+)/\\1/p'",
            "format": "{>25} │"
        },
        {
            "type": "gpu",
            "key": "│ {$2}󰾲 {$1} gpu",
            "format": "{$2}{name>25}{$1} │"
        },
        {
            "type": "shell",
            "key": "│ {$3}{$1}  shell",
            "format": "{$3}{pretty-name>23}{$1} │",
        },
        {
            "type": "packages",
            "key": "│   pkgs  ",
            "format": "{all>22} │"
        },
        {
            "type": "terminal",
            "key": "│ {$2} {$1} term",
            "format": "{$2}{>24}{$1} │"
        },
        {
            "type": "wm",
            "key": "│   wm",
            "format": "{>26} │"
        },
        {
            "type": "os",
            "key": "│ {$4}󰻀{$1}  distro",
            "format": "{$4}{pretty-name>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}

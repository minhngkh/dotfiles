{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "autoUpdate": false,
  "disabled_agents": ["observer"],
  "disabled_skills": [
    "ask-matt",
    "clonedeps",
    "codemap",
    "customize-opencode",
    "deepwork",
    "grill-me",
    "grill-with-docs",
    "handoff",
    "improve-codebase-architecture",
    "oh-my-opencode-slim",
    "plannotator-*",
    "reflect",
    "release-smoke-test",
    "setup-matt-pocock-skills",
    "teach",
    "to-spec",
    "to-tickets",
    "triage",
    "wayfinder",
    "worktrees",
    "writing-great-skills",
  ],
  "preset": "casual",
  "stripOrchestratorModel": true,
  "presets": {
    "plan": {
      "orchestrator": {
        "temperature": 0.6,
        "model": "github-copilot/gpt-5.6-luna",
        "variant": "high",
        "skills": ["*"],
        "mcps": ["*", "!context7", "!gh_grep", "!executor"],
      },
      "oracle": {
        "temperature": 0.6,
        "model": "github-copilot/gpt-5.6-luna",
        "variant": "xhigh",
        "skills": ["simplify", "angular", "tdd"],
        "mcps": [],
      },
      "librarian": {
        "temperature": 0.5,
        "model": "opencode-go/mimo-v2.5",
        "skills": ["angular", "btca-local"],
        "mcps": ["websearch", "context7", "gh_grep"],
      },
      "explorer": {
        "temperature": 0.5,
        "model": "opencode-go/mimo-v2.5",
        "skills": [],
        "mcps": [],
      },
      "designer": {
        "model": "opencode-go/kimi-k2.7-code",
        "skills": ["angular", "transitions-dev"],
        "mcps": [],
      },
      "fixer": {
        "temperature": 0.6,
        "model": "opencode-go/mimo-v2.5-pro",
        "skills": ["simplify", "angular", "tdd", "transitions-dev"],
        "mcps": [],
      },
      "council": {
        "temperature": 0.6,
        "model": "opencode-go/mimo-v2.5-pro",
        "skills": ["*"],
        "mcps": ["*", "!context7", "!gh_grep"],
      },
    },
    "casual": {
      "orchestrator": {
        "temperature": 0.6,
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
        "skills": ["*"],
        "mcps": ["*", "!context7", "!gh_grep"],
      },
      "oracle": {
        "temperature": 0.6,
        "model": "github-copilot/gpt-5.6-luna",
        "variant": "xhigh",
        "skills": ["simplify", "angular", "tdd"],
        "mcps": [],
      },
      "librarian": {
        "temperature": 0.5,
        "model": "opencode-go/mimo-v2.5",
        "skills": ["angular", "btca-local"],
        "mcps": ["websearch", "context7", "gh_grep"],
      },
      "explorer": {
        "temperature": 0.5,
        "model": "opencode-go/mimo-v2.5",
        "skills": [],

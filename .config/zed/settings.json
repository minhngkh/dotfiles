// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_edit_predictions": true,
  "lsp_results_location": "picker",
  "diff_view_style": "split",
  "git_panel": {
    "tree_view": true,
    "sort_by": "path",
    "group_by": "staging"
  },
  "git": {
    "inline_blame": {
      "location": "status_bar"
    }
  },
  "cli_default_open_behavior": "new_window",
  "code_lens": "on",
  "document_symbols": "off",
  // "terminal": {
  //   "dock": "right"
  // },
  "semantic_tokens": "combined",
  "wrap_guides": [80, 100],
  "agent_servers": {
    "github-copilot": {
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Base Charmed Icons",
    "dark": "Base Charmed Icons"
  },
  "edit_predictions": {
    "mode": "eager",
    "allow_data_collection": "no",
    "copilot": {
      "enable_next_edit_suggestions": true
    },
    "provider": "copilot"
  },
  "file_scan_exclusions": ["**/bin/**", "**/obj/**"],
  "agent": {
    "enable_feedback": false,
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    }
  },
  "outline_panel": {
    "indent_guides": {
      "show": "always"
    }
  },
  "project_panel": {
    "hide_root": true,
    "indent_guides": {
      "show": "always"
    },
    "entry_spacing": "standard"
  },
  "tabs": {
    "file_icons": true
  },
  "title_bar": {
    "show_worktree_name": true,
    "show_branch_status_icon": true
  },
  "proxy": "http://127.0.0.1:3128",
  "colorize_brackets": true,
  "format_on_save": "off",
  "tab_size": 2,
  "toolbar": {
    "code_actions": true
  },
  "redact_private_values": true,
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Zedokai (Filter Spectrum)"
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "experimental.theme_overrides": {
    "editor.background": "#1e1e1e",
    "editor.gutter.background": "#1e1e1e",
    "tab_bar.background": "#1e1e1e",
    "terminal.background": "#1e1e1e",
    "toolbar.background": "#1e1e1e",
    "status_bar.background": "#1e1e1e",
    "title_bar.background": "#1e1e1e",
    "panel.background": "#1e1e1e",
    "border": "#f1f1f1f1"
  },
  "lsp": {
    "angular": {
      "initialization_options": {
        "angular_language_server_path": "/home/gmi4hc/.bun/install/global/node_modules/@angular/language-server"
      }
    },
    "roslyn": {
      "settings": {
        "csharp|code_lens": {
          "dotnet_enable_references_code_lens": true,
          "dotnet_enable_tests_code_lens": true
        }
      },
      "binary": {
        "path": "/home/gmi4hc/.dotnet/tools/roslyn-language-server",
        "arguments": ["--stdio", "--autoLoadProjects"]
      }
    }
  },
  "languages": {
    "CSharp": {
      "preferred_line_length": 100,
      "use_on_type_format": false,
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "fast-csharpier",
          "arguments": ["{buffer_path}"]
        }
      },
    },
    "CSS": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "HTML": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JavaScript": {
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "JSON": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "SCSS": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TypeScript": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  }
}

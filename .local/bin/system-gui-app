#!/bin/sh

XDG_DATA_DIRS_DEFAULT="/usr/local/share:/usr/share:/var/lib/snapd/desktop"
XDG_DATA_DIRS_VALUE="${XDG_DATA_DIRS:-$XDG_DATA_DIRS_DEFAULT}"
XDG_CURRENT_DESKTOP_VALUE="${XDG_CURRENT_DESKTOP:-Hyprland}"
XDG_SESSION_TYPE_VALUE="${XDG_SESSION_TYPE:-wayland}"
XAUTHORITY_VALUE="${XAUTHORITY:-${XDG_RUNTIME_DIR:-$HOME}/.Xauthority}"
QT_QPA_PLATFORM_VALUE="${QT_QPA_PLATFORM:-wayland}"
XCURSOR_THEME_VALUE="${XCURSOR_THEME:-Bibata-Modern-Classic}"
XCURSOR_SIZE_VALUE="${XCURSOR_SIZE:-24}"
XCURSOR_PATH_VALUE="${XCURSOR_PATH:-$HOME/.local/share/icons:$HOME/.icons:/usr/local/share/icons:/usr/share/icons}"
HYPRCURSOR_THEME_VALUE="${HYPRCURSOR_THEME:-$XCURSOR_THEME_VALUE}"
HYPRCURSOR_SIZE_VALUE="${HYPRCURSOR_SIZE:-$XCURSOR_SIZE_VALUE}"

exec env -i \
  HOME="$HOME" USER="$USER" LOGNAME="${LOGNAME:-$USER}" SHELL="${SHELL:-/bin/sh}" \
  PATH="/home/gmi4hc/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
  ELECTRON_OZONE_PLATFORM_HINT="wayland" \
  QT_QPA_PLATFORM="$QT_QPA_PLATFORM_VALUE" \
  GDK_BACKEND="${GDK_BACKEND:-wayland}" \
  XCURSOR_THEME="$XCURSOR_THEME_VALUE" XCURSOR_SIZE="$XCURSOR_SIZE_VALUE" XCURSOR_PATH="$XCURSOR_PATH_VALUE" \
  HYPRCURSOR_THEME="$HYPRCURSOR_THEME_VALUE" HYPRCURSOR_SIZE="$HYPRCURSOR_SIZE_VALUE" \
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
  XDG_SESSION_TYPE="$XDG_SESSION_TYPE_VALUE" XDG_CURRENT_DESKTOP="$XDG_CURRENT_DESKTOP_VALUE" XDG_DATA_DIRS="$XDG_DATA_DIRS_VALUE" \
  HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" ALL_PROXY="${ALL_PROXY:-}" NO_PROXY="${NO_PROXY:-}" \
  http_proxy="${http_proxy:-}" https_proxy="${https_proxy:-}" all_proxy="${all_proxy:-}" no_proxy="${no_proxy:-}" \
  SSL_CERT_FILE="${SSL_CERT_FILE:-}" SSL_CERT_DIR="${SSL_CERT_DIR:-}" CURL_CA_BUNDLE="${CURL_CA_BUNDLE:-}" REQUESTS_CA_BUNDLE="${REQUESTS_CA_BUNDLE:-}" \
  LANG="${LANG:-C.UTF-8}" \
  "$@"

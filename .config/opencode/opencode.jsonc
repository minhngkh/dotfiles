{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "@plannotator/opencode@0.27.4",
      "options": {
        "workflow": "manual",
      },
    },
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}",
        },
      },
    },
  },
  "websearch": {
    "provider": "random",
  },
  "agents": {
    "explore": {
      "model": "opencode-go/mimo-v2.5",
    },
    "general": {
      "model": "opencode-go/mimo-v2.5",
    },
  },
  "references": {
    "oh-my-opencode-slim": {
      "repository": "alvinunreal/oh-my-opencode-slim",
      "branch": "master",
    },
    "pi-subagents": {
      "repository": "nicobailon/pi-subagents",
      "branch": "main",
    },
  },
}

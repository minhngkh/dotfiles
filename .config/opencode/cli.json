{
  "theme": {
    "name": "opencode"
  },
  "diffs": {
    "wrap": "word",
    "single": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "prompt": {
    "editor": false,
    "paste": "compact"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "new_location": "launch",
    "grouping": "auto",
    "markdown": "rendered",
    "verbosity": "medium",
    "tps": true
  },
  "animations": true,
  "attention": {
    "enabled": true
  },
  "tabs": {
    "enabled": false,
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "status",
    "mode": "off"
  },
  "debug": {
    "devtools": false,
    "turn_tokens": false
  },
  "plugins": ["./herdr-opencode"]
}

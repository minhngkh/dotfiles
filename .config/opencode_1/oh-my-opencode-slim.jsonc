      },
      "designer": {
        "model": "opencode-go/kimi-k2.7-code",
        "skills": ["angular", "transitions-dev"],
        "mcps": [],
      },
      "fixer": {
        "temperature": 0.6,
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "high",
        "skills": ["simplify", "angular", "tdd", "transitions-dev"],
        "mcps": [],
      },
      "council": {
        "temperature": 0.6,
        "model": "opencode-go/mimo-v2.5-pro",
        "skills": [],
        "mcps": [],
      },
    },
  },
  "council": {
    "default_preset": "balanced",
    "presets": {
      "balanced": {
        "qwen": {
          "model": "opencode-go/qwen3.7-plus",
          "variant": "high",
        },
        "kimi": {
          "model": "opencode-go/kimi-k2.7-code",
        },
        "openai": {
          "model": "github-copilot/gpt-5.6-luna",
          "variant": "xhigh",
        },
      },
    },
  },
  "agents": {
    "azure-devops": {
      "model": "opencode-go/mimo-v2.5",
      "temperature": 0.5,
      "prompt": "You handle Azure DevOps operations: create pull requests, add PR comments, create work items/user stories, query work items, manage branches, and review pipelines.. Confirm destructive or state-changing actions with the user before executing. Return concise results with links/IDs. Always use **executor** to interact with Azure DevOps",
      "orchestratorPrompt": "Delegate to @azure-devops for only Azure DevOps operations such as creating PRs, commenting on PRs, creating user stories/work items, querying work items, branch management, or pipeline tasks",
      "skills": [],
      "mcps": ["executor"],
    },
  },
}
